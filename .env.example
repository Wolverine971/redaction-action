# Copy to .env.local and adjust for your machine.
# Homebrew Postgres usually uses your macOS username with no password:
#   postgres://<your-username>@localhost:5432/redaction_action
# docker compose (see docker-compose.yml) uses the value below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/redaction_action

# AI detection runs through OpenRouter (https://openrouter.ai/keys). Without a key, only SSNs are detected.
OPENROUTER_API_KEY=
# Optional. Leave unset to use the built-in list of free models (DEFAULT_MODELS in src/lib/detect/llm.ts),
# which falls back to the next one when a model goes offline or starts charging.
# To choose: one OpenRouter model id (no fallback), or several separated by commas, tried in order.
# Per-stage overrides, same format: REDACTION_MODEL_CAST, REDACTION_MODEL_SCAN, REDACTION_MODEL_RESOLVE.
# REDACTION_MODEL=nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free
# Reasoning effort: low | medium | high
REDACTION_EFFORT=medium
